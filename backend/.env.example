# LLM API Configuration
# Use OpenRouter, OpenAI, or any OpenAI-compatible API
LLM_API_KEY=your_api_key_here
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_APP_NAME=ReeStack
LLM_APP_URL=http://localhost:5173

# Optional: TMDB API key (free) for better movie posters
TMDB_API_KEY=

# Optional: seconds to wait for the LLM before falling back to heuristics
LLM_TIMEOUT=30

# Optional: Google Books key, only used to widen book results when Open Library returns few
GOOGLE_BOOKS_API_KEY=

# Password recovery email (real SMTP; required for /auth/forgot-password)
# Without SMTP_HOST and SMTP_FROM_EMAIL the API returns 503 instead of faking a send.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=ReeStack
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Link destination and token lifetime for password recovery
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_MINUTES=30

# Rate limits (per process; use a shared store with multiple workers)
PASSWORD_RESET_RATE_LIMIT_FORGOT_IP=5
PASSWORD_RESET_RATE_LIMIT_FORGOT_IP_WINDOW=900
PASSWORD_RESET_RATE_LIMIT_FORGOT_EMAIL=3
PASSWORD_RESET_RATE_LIMIT_FORGOT_EMAIL_WINDOW=900
PASSWORD_RESET_RATE_LIMIT_RESET_IP=10
PASSWORD_RESET_RATE_LIMIT_RESET_IP_WINDOW=900
